# Secrets & machine config
# release_guard.local holds the owner-identifying release-guard terms —
# never track it and never ship it.
*.local
.env
# Ignore every .env.* variant (incl. setup's timestamped .env.bak.* backups, which
# can contain a real token) — but keep the shippable template.
.env.*
!.env.example
*.env.bak
settings.json
# settings.json backups setup writes when recording claude_exe / vault_path.
settings.json.bak.*
*.pem

# Runtime data (user files, never ship). data/* (not data/) so the
# !data/.gitkeep negation can actually re-include the keep file.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Rollback backups (never track these; the release builder also excludes them).
# .env.example / settings.example.json / data/.gitkeep are kept by the rules above.
*.bak
*.pre-*

# Release build output
dist/

# Heavy TTS model artifacts — distributed via download, never the repo
*.onnx
voices-*.bin
cloudflared.exe

# Internal process / strategy docs — kept LOCAL ONLY, never in the public repo.
# They stay on disk for local use; the release builder already deny-lists them.
/HANDOFF.md
/KNOWN_ISSUES.md
/docs/ROADMAP.md
/docs/DECISION_LOG.md
/docs/NAME_DECISION_EVIDENCE.md

# Vendor license signing key + issuing tooling — NEVER commit or ship
scripts/vendor/

# Maintainer-only installer code-signing config (machine-specific ACS paths) — never ship
scripts/signing.local.ps1

# Internal go-to-market strategy — public repo, keep local-only
docs/SELLING_ADAM.md
